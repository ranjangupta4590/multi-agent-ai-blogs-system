# Copy this template into a Jenkins "Secret file" credential named
# blogpilot-production-env. Keep the populated file off GitHub and out of the repo.
# Generate password/secret values with: openssl rand -hex 32

POSTGRES_DB=blogpilot
POSTGRES_USER=blogpilot
POSTGRES_PASSWORD=
DATABASE_URL=

REDIS_PASSWORD=
REDIS_URL=

SECRET_KEY=
ENVIRONMENT=production
SECURE_COOKIES=true
SESSION_COOKIE_NAME=ai_blog_session
ALLOWED_CORS_ORIGINS=["https://blogpilot.duckdns.org"]
CSP_CONNECT_SRC=https://blogpilot.duckdns.org
APP_PUBLIC_URL=https://blogpilot.duckdns.org
NEXT_PUBLIC_API_URL=https://blogpilot.duckdns.org/api/v1

# One initial internal administrator. It is used only when no ADMIN exists.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
RESET_INITIAL_ADMIN_PASSWORD=false

# Configure only the provider you intend to use. Leave every other provider blank.
ACTIVE_PROVIDER=
ACTIVE_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
FALLBACK_ENABLED=false
FALLBACK_PROVIDER=

# Optional SMTP, required only for invitation email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

MAX_COST_PER_ARTICLE_USD=5.00
MAX_COST_PER_PROJECT_USD=100.00
MAX_COST_PER_USER_USD=250.00
