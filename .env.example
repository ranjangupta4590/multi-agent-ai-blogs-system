# Copy this file to .env for local Docker development. Never commit .env.
# Generate local values with: openssl rand -hex 32

# Database (PostgreSQL with pgvector)
POSTGRES_DB=blog_platform
POSTGRES_USER=blog_user
POSTGRES_PASSWORD=
DATABASE_URL=

# Redis Queue & Rate Limiter
REDIS_PASSWORD=
REDIS_URL=

# Security (JWT & Cookies). Use at least 32 random characters.
SECRET_KEY=
SESSION_COOKIE_NAME=ai_blog_session
SECURE_COOKIES=false
ENVIRONMENT=development
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Set true once only to reset an existing local bootstrap-admin password, then set it back to false.
RESET_INITIAL_ADMIN_PASSWORD=false

# Server-side invitation email. These values are never sent to the browser.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
APP_PUBLIC_URL=http://localhost:3000


# LLM Provider Credentials (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Notice: The system requires only ONE provider to operate!
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Active Provider Strategy
ACTIVE_PROVIDER=
ACTIVE_MODEL=
FALLBACK_ENABLED=false
FALLBACK_PROVIDER=

# AI Budget Caps (USD)
MAX_COST_PER_ARTICLE_USD=5.00
MAX_COST_PER_PROJECT_USD=100.00
MAX_COST_PER_USER_USD=250.00

# Frontend URL for CORS
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CSP_CONNECT_SRC=http://localhost:3000 http://localhost:8000
